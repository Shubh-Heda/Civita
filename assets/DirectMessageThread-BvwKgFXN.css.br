.dm-container{display:flex;flex-direction:column;height:100vh;background:linear-gradient(135deg,#667eea,#764ba2);font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen,Ubuntu,Cantarell,sans-serif}.dm-header{background:#ffffff1a;backdrop-filter:blur(10px);padding:16px 20px;color:#fff;border-bottom:1px solid rgba(255,255,255,.2)}.header-content{display:flex;flex-direction:column;gap:4px}.dm-header h1{margin:0;font-size:20px;font-weight:600}.header-status{display:flex;align-items:center;gap:8px;font-size:13px;opacity:.9}.status-indicator{width:8px;height:8px;border-radius:50%;background:#4ade80}.status-indicator.offline{background:#9ca3af}.dm-messages{flex:1;overflow-y:auto;padding:20px;display:flex;flex-direction:column;gap:12px}.no-messages{display:flex;align-items:center;justify-content:center;height:100%;color:#fff9;font-size:16px}.load-more-btn{padding:10px 16px;margin:0 auto;background:#fff3;color:#fff;border:1px solid rgba(255,255,255,.3);border-radius:8px;cursor:pointer;font-size:12px;font-weight:500;transition:background .2s}.load-more-btn:hover{background:#ffffff4d}.dm-message{display:flex;flex-direction:column;gap:4px;max-width:70%;animation:messageSlideIn .3s ease-out}.dm-message.sent{align-self:flex-end}.dm-message.received{align-self:flex-start}@keyframes messageSlideIn{0%{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}.message-bubble{padding:10px 14px;border-radius:16px;word-wrap:break-word;font-size:14px;line-height:1.4;box-shadow:0 1px 2px #0000001a}.dm-message.sent .message-bubble{background:#fff;color:#333;border-bottom-right-radius:4px}.dm-message.received .message-bubble{background:#fffffff2;color:#333;border-bottom-left-radius:4px}.message-meta{display:flex;align-items:center;gap:6px;font-size:11px;color:#ffffffb3;padding:0 4px}.dm-message.sent .message-meta{justify-content:flex-end}.read-indicator{color:#4ade80;font-weight:600}.dm-input-area{display:flex;gap:12px;padding:16px 20px;background:#ffffff1a;border-top:1px solid rgba(255,255,255,.2)}.dm-input{flex:1;padding:12px 16px;border:none;border-radius:24px;font-size:14px;outline:none;background:#fff;color:#333;resize:none;transition:box-shadow .2s}.dm-input:focus{box-shadow:0 0 0 2px #667eea80}.dm-input::placeholder{color:#999}.dm-send-btn{padding:12px 24px;background:#fff;color:#667eea;border:none;border-radius:24px;cursor:pointer;font-weight:600;font-size:14px;transition:all .2s;min-width:70px}.dm-send-btn:hover:not(:disabled){background:#f0f0f0;transform:translateY(-1px)}.dm-send-btn:active:not(:disabled){transform:translateY(0)}.dm-send-btn:disabled{opacity:.5;cursor:not-allowed}.dm-loading,.dm-error{display:flex;align-items:center;justify-content:center;height:100vh;color:#fff;font-size:18px}.dm-error{background:#dc3545}.dm-messages::-webkit-scrollbar{width:6px}.dm-messages::-webkit-scrollbar-track{background:transparent}.dm-messages::-webkit-scrollbar-thumb{background:#ffffff4d;border-radius:3px}.dm-messages::-webkit-scrollbar-thumb:hover{background:#ffffff80}@media(max-width:768px){.dm-message{max-width:85%}.dm-header h1{font-size:16px}.dm-input-area{padding:12px 16px}.dm-send-btn{padding:10px 16px;font-size:12px}}
