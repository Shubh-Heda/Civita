.discovery-hub{min-height:100vh;background:linear-gradient(135deg,#667eea,#764ba2,#f093fb);padding:2rem;font-family:Segoe UI,Tahoma,Geneva,Verdana,sans-serif}.discovery-hub.loading{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2rem}.spinner{width:50px;height:50px;border:4px solid rgba(255,255,255,.3);border-top:4px solid white;border-radius:50%;animation:spin 1s linear infinite}@keyframes spin{0%{transform:rotate(0)}to{transform:rotate(360deg)}}.discovery-hub.loading p{color:#fff;font-size:1.1rem}.discovery-header{text-align:center;color:#fff;margin-bottom:3rem}.discovery-header h1{font-size:2.5rem;margin:0 0 .5rem;font-weight:700;text-shadow:0 2px 10px rgba(0,0,0,.2)}.discovery-header p{font-size:1.1rem;opacity:.95;margin:0}.discovery-search{max-width:600px;margin:0 auto 2rem}.search-input{width:100%;padding:1rem 1.5rem;font-size:1rem;border:none;border-radius:50px;background:#fffffff2;box-shadow:0 8px 32px #00000026;transition:all .3s cubic-bezier(.4,0,.2,1)}.search-input:focus{outline:none;box-shadow:0 12px 40px #00000040;transform:translateY(-2px)}.search-input::placeholder{color:#999}.discovery-filters{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem;margin-bottom:2rem;max-width:100%}.filter-group{display:flex;flex-direction:column;gap:.5rem}.filter-group label{color:#fff;font-weight:600;font-size:.9rem;text-shadow:0 1px 3px rgba(0,0,0,.2)}.filter-group select{padding:.75rem 1rem;border:2px solid rgba(255,255,255,.3);border-radius:8px;background:#fffffff2;font-size:.95rem;cursor:pointer;transition:all .2s ease}.filter-group select:hover{border-color:#fff9}.filter-group select:focus{outline:none;border-color:#fff;box-shadow:0 0 0 3px #fff3}.view-toggle{display:flex;gap:.5rem}.view-btn{flex:1;padding:.75rem 1rem;border:2px solid rgba(255,255,255,.3);border-radius:8px;background:#ffffff1a;color:#fff;font-size:1.2rem;cursor:pointer;transition:all .2s ease}.view-btn:hover{border-color:#fff9;background:#fff3}.view-btn.active{background:#fff;color:#667eea;border-color:#fff}.results-counter{text-align:center;color:#fff;margin-bottom:2rem;font-size:1rem}.results-counter strong{font-weight:700;font-size:1.1rem}.matches-container{display:grid;gap:1.5rem;max-width:100%}.matches-container.grid{grid-template-columns:repeat(auto-fill,minmax(300px,1fr))}.matches-container.list{grid-template-columns:1fr}.match-card{background:#fff;border-radius:16px;padding:1.5rem;box-shadow:0 10px 40px #0000001a;transition:all .3s cubic-bezier(.4,0,.2,1);transform:translateY(0);overflow:hidden;position:relative}.match-card:before{content:"";position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#667eea,#764ba2,#f093fb)}.match-card:hover{transform:translateY(-8px);box-shadow:0 15px 50px #00000026}.match-card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;gap:1rem}.match-sport{display:flex;align-items:center;gap:.5rem}.sport-emoji{font-size:1.8rem}.sport-name{font-weight:600;color:#333;font-size:1rem}.visibility-badge{padding:.4rem .8rem;border-radius:20px;font-size:.8rem;font-weight:600;white-space:nowrap;display:flex;align-items:center;gap:.3rem}.visibility-badge.community{background:#e3f2fd;color:#1976d2}.visibility-badge.nearby{background:#f3e5f5;color:#7b1fa2}.visibility-badge.private{background:#fff3e0;color:#e65100}.match-title{margin:0 0 1rem;font-size:1.3rem;font-weight:700;color:#222;line-height:1.3}.match-details{margin-bottom:1.5rem;display:flex;flex-direction:column;gap:.75rem}.detail-row{display:flex;flex-wrap:wrap;align-items:flex-start;gap:.5rem;font-size:.95rem}.detail-row .label{font-weight:600;color:#667eea;min-width:80px}.detail-row .value{color:#555;flex:1}.available-seats{display:inline-flex;align-items:center;gap:.3rem;margin-left:.5rem;padding:.2rem .6rem;background:#e8f5e9;color:#2e7d32;border-radius:4px;font-size:.85rem;font-weight:600}.available-seats.full{background:#ffebee;color:#c62828}.match-card-footer{display:flex;gap:.75rem}.join-btn,.view-details-btn{flex:1;padding:.75rem 1rem;border:none;border-radius:8px;font-size:.95rem;font-weight:600;cursor:pointer;transition:all .2s ease}.join-btn{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff}.join-btn:hover:not(.disabled){transform:translateY(-2px);box-shadow:0 8px 20px #667eea4d}.join-btn.disabled{background:#ccc;cursor:not-allowed;opacity:.7}.view-details-btn{background:#f5f5f5;color:#667eea;border:2px solid #e0e0e0}.view-details-btn:hover{background:#f0f0f0;border-color:#667eea}.no-matches{text-align:center;padding:4rem 2rem;background:#fffffff2;border-radius:16px;box-shadow:0 10px 40px #0000001a}.no-matches-icon{font-size:3rem;margin-bottom:1rem;animation:bounce 1s infinite}@keyframes bounce{0%,to{transform:translateY(0)}50%{transform:translateY(-10px)}}.no-matches h3{margin:0 0 .5rem;color:#333;font-size:1.5rem}.no-matches p{color:#666;margin:0 0 1.5rem;font-size:1rem}.reset-filters-btn{padding:.75rem 1.5rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:8px;font-weight:600;cursor:pointer;transition:all .2s ease}.reset-filters-btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px #667eea4d}@media(max-width:768px){.discovery-hub{padding:1rem}.discovery-header h1{font-size:1.8rem}.discovery-filters,.matches-container.grid{grid-template-columns:1fr}.match-card{padding:1rem}.match-title{font-size:1.1rem}.detail-row{flex-direction:column}.detail-row .label{width:100%}}@media(max-width:480px){.discovery-header h1{font-size:1.5rem}.discovery-header p{font-size:.95rem}.search-input{font-size:16px}.match-card{padding:1rem}.match-card-footer{flex-direction:column}.join-btn,.view-details-btn{width:100%}.visibility-badge{font-size:.75rem;padding:.3rem .6rem}}
